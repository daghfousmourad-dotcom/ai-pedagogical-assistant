# Configuration Modèles Locaux Économes en RAM (Ollama)
LLM_PROVIDER=OLLAMA
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:7b

# Bases de données & Services
